+static void video_decode_progress(int completed, int total, void*) {
+    fprintf(stderr, "OFFGRID_VIDEO_DECODE %d %d\n", completed, total);
+    fflush(stderr);
+}
+
+static void video_decoded_frame(const sd_image_t* frame, void* data) {
+    auto* params = static_cast<SDCliParams*>(data);
+    if (params->decode_preview_path.empty() || frame == nullptr || frame->data == nullptr) return;
+    const auto temporary = params->decode_preview_path + ".tmp.png";
+    if (write_image_to_file(temporary, frame->data, frame->width, frame->height,
+                            frame->channel, "", params->compression_quality)) {
+        std::error_code error;
+        fs::rename(temporary, params->decode_preview_path, error);
+        if (!error) {
+            fprintf(stderr, "OFFGRID_VIDEO_FRAME %u %u\n", frame->width, frame->height);
+            fflush(stderr);
+        }
+    }
+}
