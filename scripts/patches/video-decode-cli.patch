+static void video_decode_progress(int completed, int total, void*) {
+    fprintf(stderr, "OFFGRID_VIDEO_DECODE %d %d\n", completed, total);
+    fflush(stderr);
+}
+
+static void video_decoded_frame(const sd_tensor_t* frame, void* data) {
+    auto* params = static_cast<SDCliParams*>(data);
+    if (params->decode_preview_path.empty() || frame == nullptr) return;
+    SDImage image = tensor_image_view(frame);
+    if (image.data == nullptr) return;
+    const auto temporary = params->decode_preview_path + ".tmp.png";
+    if (write_image_to_file(temporary, image.data, image.width, image.height,
+                            image.channel, "", params->compression_quality)) {
+        std::error_code error;
+        fs::rename(temporary, params->decode_preview_path, error);
+        if (!error) {
+            fprintf(stderr, "OFFGRID_VIDEO_FRAME %u %u\n", image.width, image.height);
+            fflush(stderr);
+        }
+    }
+}
