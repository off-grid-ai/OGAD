+static sd_video_decode_progress_cb_t sd_decode_progress_cb = nullptr;
+static sd_video_decoded_frame_cb_t sd_decoded_frame_cb = nullptr;
+static void* sd_decode_cb_data = nullptr;
+static thread_local bool sd_video_decode_active = false;
+
+SDVideoDecodeScope::SDVideoDecodeScope() : previous(sd_video_decode_active) {
+    sd_video_decode_active = true;
+    sd_video_decode_progress(0, 0);
+}
+SDVideoDecodeScope::~SDVideoDecodeScope() { sd_video_decode_active = previous; }
+void sd_video_decode_progress(int completed, int total) {
+    if (sd_video_decode_active && sd_decode_progress_cb)
+        sd_decode_progress_cb(completed, total, sd_decode_cb_data);
+}
+void sd_video_decoded_frame(const sd_image_t* frame) {
+    if (frame && frame->data && sd_decoded_frame_cb)
+        sd_decoded_frame_cb(frame, sd_decode_cb_data);
+}
+void sd_set_video_decode_callback(sd_video_decode_progress_cb_t progress, sd_video_decoded_frame_cb_t frame, void* data) {
+    sd_decode_progress_cb = progress;
+    sd_decoded_frame_cb = frame;
+    sd_decode_cb_data = data;
+}
