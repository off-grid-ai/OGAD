#!/bin/sh
# Fast local push gate. CI owns full coverage, DB, heavy integration, and E2E.
set -e

ZERO_OID="0000000000000000000000000000000000000000"

new_branch_base() {
  local_oid=$1
  for candidate in "${OFFGRID_PUSH_BASE:-}" origin/release/computer_use origin/main; do
    [ -z "$candidate" ] && continue
    if git rev-parse --verify --quiet "$candidate^{commit}" >/dev/null; then
      git merge-base "$local_oid" "$candidate"
      return
    fi
  done
  git rev-list --max-parents=0 "$local_oid" | tail -1
}

collect_changed_files() {
  if [ -t 0 ]; then
    git diff --name-only --diff-filter=ACMR '@{upstream}..HEAD' 2>/dev/null || true
    return
  fi

  while read -r _local_ref local_oid _remote_ref remote_oid; do
    [ -z "$local_oid" ] && continue
    [ "$local_oid" = "$ZERO_OID" ] && continue

    if [ "$remote_oid" = "$ZERO_OID" ]; then
      # A new branch has no remote tip. Diff its complete range from the release
      # base. Passing several commits to diff-tree can silently compare trees and
      # omit earlier commits in the push.
      base=$(new_branch_base "$local_oid")
      git diff --name-only --diff-filter=ACMR "$base..$local_oid"
    else
      git diff --name-only --diff-filter=ACMR "$remote_oid..$local_oid"
    fi
  done | sed '/^$/d' | sort -u
}

CHANGED_FILES=$(collect_changed_files)
CHANGED_CODE=$(printf '%s\n' "$CHANGED_FILES" | grep -E '\.(ts|tsx|js|jsx)$' || true)

project_node() {
  required_major=$(sed -E 's/^v?([0-9]+).*/\1/' .nvmrc)
  current_major=$(node -p 'process.versions.node.split(".")[0]')
  if [ "$current_major" = "$required_major" ]; then
    command -v node
    return
  fi

  for candidate in \
    "$HOME/.nvm/versions/node"/v"$required_major".*/bin/node \
    "/opt/homebrew/opt/node@$required_major/bin/node" \
    "/usr/local/opt/node@$required_major/bin/node"; do
    if [ -x "$candidate" ]; then
      printf '%s\n' "$candidate"
      return
    fi
  done

  echo "[pre-push] Node $required_major is required by .nvmrc and package.json. Install it before pushing." >&2
  exit 1
}

if [ -z "$CHANGED_CODE" ] && ! printf '%s\n' "$CHANGED_FILES" | grep -qx 'pro'; then
  echo "[pre-push] no JavaScript or TypeScript or Pro changes — fast gate passed."
  exit 0
fi

if [ -n "$CHANGED_CODE" ]; then
  echo "[pre-push] typecheck"
  npm run --silent typecheck
fi

echo "[pre-push] Pro typecheck"
(cd pro && npx tsc --noEmit -p tsconfig.json)

if [ -n "$CHANGED_CODE" ]; then
  echo "[pre-push] tests related to pushed files"
  PROJECT_NODE=$(project_node)
  PROJECT_NODE_PATH=$(dirname "$PROJECT_NODE")
  PROJECT_PATH="$PROJECT_NODE_PATH:$PATH"
  OFFGRID_HOOK_DATA_DIR=$(mktemp -d)
  restore_hook_state() {
    if [ "${OFFGRID_NODE_NATIVE_REBUILT:-0}" = 1 ]; then
      echo "[pre-push] restoring Electron native dependencies"
      PATH="$PROJECT_PATH" ./node_modules/.bin/electron-rebuild \
        -f -w better-sqlite3-multiple-ciphers >/dev/null 2>&1 \
        || PATH="$PROJECT_PATH" ./node_modules/.bin/electron-builder \
          install-app-deps >/dev/null 2>&1 \
        || true
      ./scripts/probe-electron-sqlite.sh '[pre-push]'
    fi
    rm -rf -- "$OFFGRID_HOOK_DATA_DIR"
  }
  trap restore_hook_state EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
  export OFFGRID_DATA_DIR="$OFFGRID_HOOK_DATA_DIR"
  echo "[pre-push] preparing native dependencies for $($PROJECT_NODE -v)"
  OFFGRID_NODE_NATIVE_REBUILT=1
  PATH="$PROJECT_PATH" npm explore better-sqlite3-multiple-ciphers -- \
    npm run build-release >/dev/null 2>&1
  printf '%s\n' "$CHANGED_CODE" | tr '\n' '\0' | \
    xargs -0 env PATH="$PROJECT_PATH" "$PROJECT_NODE" ./node_modules/vitest/vitest.mjs \
      related --run --project product-integration --passWithNoTests --bail=1
fi

echo "[pre-push] fast gate passed. CI runs full coverage, DB, heavy integration, and E2E."
